# ==============================================================================
# OPENDOOR BACKEND ENVIRONMENT CONFIGURATION
# ==============================================================================

# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Security / JWT Secrets
JWT_ACCESS_SECRET=your_super_secret_jwt_access_key_change_in_production
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_key_change_in_production
QR_JWT_SECRET=your_super_secret_qr_jwt_key_change_in_production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN_DAYS=7

# Database (PostgreSQL) - Deferred for now
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/opendoor_db

# Redis (for Socket.io adapter & BullMQ) - Optional in dev
REDIS_URL=redis://localhost:6379

# Razorpay Credentials (Test Mode)
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=rzp_secret_placeholder
RAZORPAY_WEBHOOK_SECRET=rzp_webhook_secret_placeholder

# AWS S3 / Object Storage (Photos, Floor Plans, Receipts)
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=placeholder
AWS_SECRET_ACCESS_KEY=placeholder
AWS_S3_BUCKET=opendoor-documents

# Push Notifications (FCM)
FCM_SERVER_KEY=placeholder
